{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "node": "20.x",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "node": "20.x",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "20.x",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "credentialsSource": "remote"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
