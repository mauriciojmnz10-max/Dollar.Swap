{
  "expo": {
    "name": "Dollar Swap",
    "slug": "dollar-swap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.tuempresa.dollarsawp",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Dollar Swap necesita acceso a tu galería para seleccionar fotos de billetes.",
          "cameraPermission": "Dollar Swap necesita acceso a tu cámara para tomar fotos de billetes."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permite usar Face ID para acceder a tus datos seguros."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4c0f8fb4-bdb4-4fde-a368-4935a82d2112"
      }
    }
  }
}
